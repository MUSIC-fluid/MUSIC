+// MD_EXACT_FP at the start of a function body: IEEE arithmetic in it on
+// Metal also when the kernels are compiled in the relaxed floating-point
+// mode (gpu_relaxed_math). The velocity solvers (Solver in device_ideal.h)
+// decide whether a cell is solved, capped, regulated or reverted; relaxed
+// rounding there changed those decisions in dilute, fast cells (failed
+// brackets, reverts that the CPU code does not make), so they stay exact
+#if defined(__METAL_VERSION__)
+#define MD_EXACT_FP _Pragma("METAL fp math_mode(safe)")
+#else
+#define MD_EXACT_FP
+#endif
+
 namespace music_device {
 
 #if defined(__METAL_VERSION__)
@@ -149,6 +161,30 @@ MD_FN Real dexpm1(Real y) {
     return (um1 * y / log(u));
 }
 
+// NaN and infinity tests. On Metal on the bits of the float, which no math
+// mode can fold: with MTLMathModeRelaxed (metal_backend.m) the compiler
+// folded the NaN test x != x of solveU0Hybrid to false, so the NaN of a
+// failed solve passed as a solution, and it may treat isnan / isfinite the
+// same way. Elsewhere isnan / isfinite (x != x is isnan(x)), so the device
+// code on the CPU and in CUDA computes as before
+#if defined(__METAL_VERSION__)
+MD_FN bool mdIsNan(float x) {
+    return ((as_type<uint>(x) & 0x7fffffffu) > 0x7f800000u);
+}
+MD_FN bool mdIsFinite(float x) {
+    return ((as_type<uint>(x) & 0x7f800000u) != 0x7f800000u);
+}
+#else
+template <typename Real>
+MD_FN bool mdIsNan(Real x) {
+    return (isnan(x));
+}
+template <typename Real>
+MD_FN bool mdIsFinite(Real x) {
+    return (isfinite(x));
+}
+#endif
+
