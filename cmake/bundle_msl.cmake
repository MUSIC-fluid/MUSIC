# cmake -DOUT=<file> -DINPUTS=<a;b;...> -P bundle_msl.cmake
# writes the inputs as one C string literal, kMusicMetalSource
set(body "#define MUSIC_DEVICE_BUNDLED\n")
foreach(f ${INPUTS})
    file(READ "${f}" text)
    string(APPEND body "${text}\n")
endforeach()
string(REPLACE "\\" "\\\\" body "${body}")
string(REPLACE "\"" "\\\"" body "${body}")
string(REPLACE "\n" "\\n\"\n\"" body "${body}")
file(WRITE "${OUT}.tmp"
     "/* generated by cmake/bundle_msl.cmake: do not edit */\n"
     "static const char *kMusicMetalSource =\n\"${body}\";\n")
file(COPY_FILE "${OUT}.tmp" "${OUT}" ONLY_IF_DIFFERENT)
file(REMOVE "${OUT}.tmp")
